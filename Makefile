# Stable verification entrypoint. This plugin ships no unit tests (see
# CLAUDE.md § Verification): `make test` runs only the structural verifier,
# which is the mechanism anchor the principles bind to, not a unit test.

# The scripts print emoji and Chinese; a Windows console on cp950 raises
# UnicodeEncodeError on them unless Python writes UTF-8.
export PYTHONIOENCODING := utf-8
export PYTHONUTF8 := 1

.PHONY: test parity-check ship-check codex-lint
test:
	python3 scripts/verify-skills.py

# Codex parity gate. The Codex copy under codex/plugins/baransu/ is maintained
# by hand (see AGENTS.md); this checks that every skill file has a counterpart
# on the other side (Codex-only agents/openai.yaml allowed) and that the two
# manifest versions match. It checks structure only. Deliberately NOT part of
# `make test` — mid-development edits may lag on one side. There is no CI and
# no cron in this repo: `make ship-check` below is the one entrypoint that runs it.
parity-check:
	python3 scripts/verify-codex-parity.py

# The Codex lint hook: the shared engine plus the Codex adapter, bundled into the one file the Codex plugin
# runs (codex/plugins/baransu/hooks/hooks.json). The one build step in this repo, pinned so the output is
# reproducible (docs/adr/0001-codex-lint-bundle.md). Run it after any change under
# plugins/baransu/hooks/{engine,util,adapters/codex}/ and commit the result. Its first line records the
# sources' hash; parity-check fails when the sources moved on without a rebuild.
LINT_HASH = $(shell python3 scripts/verify-codex-parity.py --lint-hash)
codex-lint:
	npx -y esbuild@0.25.0 plugins/baransu/hooks/adapters/codex/main.ts --bundle --platform=node --format=esm --target=node18 --legal-comments=none --log-level=warning --banner:js="// GENERATED by make codex-lint from plugins/baransu/hooks (engine + adapters/codex), sources sha256:$(LINT_HASH). Do not edit." --outfile=codex/plugins/baransu/hooks/lint.mjs

# Pre-ship gate: the structural verifier plus the Codex parity check, in that order.
# Never merge parity-check into `test`; bundling is ship-check's job.
ship-check: test parity-check
	@echo "== ship-check green (test + parity-check)"
