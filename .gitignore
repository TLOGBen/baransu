# --- everything-cli / Claude Code pipeline state ---
# Transient handoff artifacts, flow-state, health pulses.
.agent-workspace/

# strategic-advance campaign state — local only.
.strategic-advance/

# Archived session work files (baransu /ship output — local only).
.claude/archived/
/.claude/archived/
/.codex/archived/

# Transient baransu workspace dirs — local only, archived by /ship into .claude/archived/.
.claude/dev/
.claude/think/
.claude/evolve/
.claude/review/
.claude/hunt-report/
.claude/impl/

# Root-level work contracts (/contract output). Unsealed ones stay at the repo
# root while work is open; sealed ones are archived by /ship into the ignored
# .claude/archived/. Neither stage belongs in version control.
/CONTRACT-*.md

# Codex-side mirror of the same transient workspace dirs — local only.
# Only the plugin mirror under codex/plugins/ is tracked; .codex/ is session state.
.codex/dev/
.codex/think/
.codex/evolve/
.codex/review/
.codex/hunt-report/
.codex/impl/
.codex/read/
.codex/learn/
.codex/delegate-matrix-*/
# Loose session work files at the .codex root (assessments, delegation ledgers).
/.codex/*.md
/.codex/*.html

# baransu working data — local dogfooding artifacts, regenerated per session.
# Useless to plugin installers (they re-initialize their own). Only the shared
# .claude/settings.json stays tracked.
.claude/read/
.claude/learn/
.claude/research/
.claude/loop-state.json
.claude/loop-final-report.md

# self-healing harness telemetry — local only
# Directory persists by virtue of telemetry being written into it; no .gitkeep needed.
.claude/harness/

# Skill eval / optimization workspaces (transient, local only).
eval-workspace/

# Leftover from the retired 紙 preset (pre-6.0.0 /design); kept ignored so a stale
# local copy at the repo root never gets committed.
/紙-sanity.sh

# Session telemetry written by the everything-cli harness.
# knowledge/solutions/ and other curated content under knowledge/ stays tracked.
knowledge/skill-telemetry.jsonl
knowledge/**/*.telemetry.jsonl

# Plugin cache / local install scratch (if a dev ever symlinks here).
.claude/plugins/cache/

# Runtime lock files written by ScheduleWakeup / /loop.
.claude/scheduled_tasks.lock

# Per-skill eval + optimization workspaces (transient artifacts from skill-creator).
plugins/*/skills/*-workspace/

# Per-user Claude Code settings — .claude/settings.json stays shared, only .local is ignored.
.claude/settings.local.json
.claude/**/settings.local.json

# --- Secrets ---
.env
.env.*
!.env.example

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Future toolchains (safe to keep pre-emptively) ---
node_modules/
dist/
build/
*.log
.cache/
.tmp/

# design skill working files (extraction notes) + skill-creator workspace
.claude/design/
.claude/skill-creator/
