{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/lint.mjs\"",
            "timeout": 120,
            "statusMessage": "baransu lint",
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "if command -v node >/dev/null 2>&1; then printf '{}'; else printf '%s' '{\"systemMessage\":\"baransu lint \\u6c92\\u5728\\u8dd1\\uff1a\\u627e\\u4e0d\\u5230 Node\\u3002\\u88dd Node\\uff0818 \\u4ee5\\u4e0a\\uff09\\u4e26\\u653e\\u4e0a PATH\\uff0c\\u9019\\u500b\\u5c08\\u6848\\u7684 lint \\u898f\\u5247\\u624d\\u6703\\u88ab\\u6aa2\\u67e5\\u3002\",\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"baransu lint \\u6c92\\u5728\\u8dd1\\uff1a\\u627e\\u4e0d\\u5230 Node\\u3002\\u88dd Node\\uff0818 \\u4ee5\\u4e0a\\uff09\\u4e26\\u653e\\u4e0a PATH\\uff0c\\u9019\\u500b\\u5c08\\u6848\\u7684 lint \\u898f\\u5247\\u624d\\u6703\\u88ab\\u6aa2\\u67e5\\u3002\"}}'; fi",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "baransu lint: Node"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/lint.mjs\"",
            "timeout": 120,
            "statusMessage": "baransu lint",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/lint.mjs\"",
            "timeout": 120,
            "statusMessage": "baransu lint",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/lint.mjs\"",
            "timeout": 120,
            "statusMessage": "baransu lint",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
