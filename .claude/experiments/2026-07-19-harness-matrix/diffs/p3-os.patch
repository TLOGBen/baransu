+                hit: make_hit_author("超維術士", "http://a", Some("牧狐")),
+                source_names: vec!["A".to_string()],
+            },
+            HitOrStatus::Hit {
+                hit: make_hit_author("超維術士", "http://b", Some("別人")),
+                source_names: vec!["B".to_string()],
+            },
+        ];
+        let folded = fold_hits(rows);
+        assert_eq!(folded.len(), 2, "同名不同作者不應折疊");
+    }
+
+    /// C18: Hit(X@A), Hit(Y@A), Hit(X@B) → X 折在 index0（含 A,B），Y 在 index1。
+    #[test]
+    fn c18_folded_row_keeps_first_occurrence_position() {
+        let rows = vec![
+            hit_row("X", "http://a1", "A"),
+            hit_row("Y", "http://a2", "A"),
+            hit_row("X", "http://b1", "B"),
+        ];
+        let folded = fold_hits(rows);
+        assert_eq!(folded.len(), 2, "X 折疊、Y 單獨 → 共兩行");
+        match &folded[0] {
+            HitOrStatus::Hit { hit, source_names } => {
+                assert_eq!(hit.name, "X");
+                assert_eq!(source_names, &vec!["A".to_string(), "B".to_string()]);
+            }
+            HitOrStatus::StatusLine(s) => panic!("index0 應為 X 的折疊 Hit，得 StatusLine: {}", s),
+        }
+        match &folded[1] {
+            HitOrStatus::Hit { hit, source_names } => {
+                assert_eq!(hit.name, "Y");
+                assert_eq!(source_names, &vec!["A".to_string()]);
+            }
+            HitOrStatus::StatusLine(s) => panic!("index1 應為 Y，得 StatusLine: {}", s),
+        }
+    }
+
+    /// C20: Hit(X@A), StatusLine(s1), Hit(X@B), StatusLine(s2)
+    /// → 兩個 StatusLine 都保留，s1 在 s2 之前，X 折疊。
+    #[test]
+    fn c20_status_lines_kept_with_relative_order_preserved() {
+        let rows = vec![
+            hit_row("X", "http://a", "A"),
+            HitOrStatus::StatusLine("s1".to_string()),
+            hit_row("X", "http://b", "B"),
+            HitOrStatus::StatusLine("s2".to_string()),
+        ];
+        let folded = fold_hits(rows);
+        assert_eq!(folded.len(), 3, "1 折疊 Hit + 2 StatusLine = 3 行");
+        match &folded[0] {
+            HitOrStatus::Hit { hit, source_names } => {
+                assert_eq!(hit.name, "X");
+                assert_eq!(source_names, &vec!["A".to_string(), "B".to_string()]);
+            }
+            HitOrStatus::StatusLine(s) => panic!("index0 應為折疊 Hit，得 StatusLine: {}", s),
+        }
+        match &folded[1] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "s1"),
+            HitOrStatus::Hit { .. } => panic!("index1 應為 s1"),
+        }
+        match &folded[2] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "s2"),
+            HitOrStatus::Hit { .. } => panic!("index2 應為 s2"),
+        }
+    }
+
+    /// 邊界：fold_hits(vec![]) == vec![]。
+    #[test]
+    fn fold_hits_empty_input_returns_empty() {
+        assert!(fold_hits(vec![]).is_empty());
+    }
+
+    /// 邊界：兩個 author=None 同名 → 折成一行（key 用空字串代表 None）。
+    #[test]
+    fn fold_hits_two_none_authors_same_name_fold_to_one() {
+        let rows = vec![
+            HitOrStatus::Hit {
+                hit: make_hit_author("無作者書", "http://a", None),
+                source_names: vec!["A".to_string()],
+            },
+            HitOrStatus::Hit {
+                hit: make_hit_author("無作者書", "http://b", None),
+                source_names: vec!["B".to_string()],
+            },
+        ];
+        let folded = fold_hits(rows);
+        assert_eq!(folded.len(), 1, "兩個 author=None 同名應折成一行");
+        match &folded[0] {
+            HitOrStatus::Hit { source_names, .. } => {
+                assert_eq!(source_names, &vec!["A".to_string(), "B".to_string()]);
+            }
+            HitOrStatus::StatusLine(s) => panic!("應為折疊 Hit，得 StatusLine: {}", s),
+        }
+    }
+
+    /// C21: 既有 assemble_rows 6 個 pure test + Esc tests 皆不變地通過
+    /// （這裡不重複斷言，僅以註解標記：本檔案內既有測試在本 task 未被刪除，
+    /// 只有 scenario1 因欄位改名而做加法式更新，其餘測試原封不動）。
+    ///
+    /// C19: 折疊行 Enter 走第一個出現的 hit 的 book_url —— 用 fold_hits 輸出組
+    /// 一個 Results 狀態、模擬選中折疊行、抽出 hit，斷言 book_url 等於
+    /// 第一個出現（source A）的 book_url，而非第二個（source B）的 book_url。
+    #[test]
+    fn c19_enter_on_folded_row_uses_first_occurrence_book_url() {
+        let hit_a = make_hit_author("超維術士", "http://a", Some("牧狐"));
+        let hit_b = make_hit_author("超維術士", "http://b", Some("牧狐"));
+        let expected_first_url = hit_a.book_url.clone();
+        let rows = vec![
+            HitOrStatus::Hit {
+                hit: hit_a,
+                source_names: vec!["A".to_string()],
+            },
+            HitOrStatus::Hit {
+                hit: hit_b.clone(),
+                source_names: vec!["B".to_string()],
+            },
+        ];
+        let folded = fold_hits(rows);
+        assert_eq!(folded.len(), 1);
+
+        // Mirror the Enter-handling extraction logic in handle_event: pull the
+        // `hit` out of the selected HitOrStatus::Hit row.
+        let selected_hit = match &folded[0] {
+            HitOrStatus::Hit { hit, .. } => Some(hit.clone()),
+            HitOrStatus::StatusLine(_) => None,
+        };
+        let extracted = selected_hit.expect("folded row 應為 Hit");
+        assert_eq!(
+            extracted.book_url, expected_first_url,
+            "Enter 應作用於第一個出現的來源（A），不是後來折入的 B"
+        );
+        assert_ne!(extracted.book_url, hit_b.book_url);
+    }
 }
