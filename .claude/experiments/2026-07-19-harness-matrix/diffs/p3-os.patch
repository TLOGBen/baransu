 /// Outcome of a successful source-switch — surfaces what the caller needs to
 /// rebuild its UI (`new_progress_idx`, `chapter_count`, `new_first_chapter_name`).
+///
+/// `migrated` / `matched_chapter_name` surface REQ-002/004: whether the old
+/// reading position was best-effort carried over (by chapter-name matching)
+/// rather than reset to the new TOC's first chapter.
 #[derive(Debug)]
 pub struct SwitchOutcome {
     pub new_progress_idx: i64,
     pub chapter_count: usize,
     pub new_first_chapter_name: String,
+    pub migrated: bool,
+    pub matched_chapter_name: Option<String>,
+}
+
+/// REQ-004 — format a human-readable migrate-vs-reset message for a
+/// successful switch. Pure fn shared by both CLI stdout and the TUI toast so
+/// the two surfaces stay textually consistent.
+pub fn format_switch_message(outcome: &SwitchOutcome) -> String {
+    if outcome.migrated {
+        let name = outcome.matched_chapter_name.as_deref().unwrap_or("");
+        format!(
+            "進度已遷移：{}（第 {} 章）",
+            name,
+            outcome.new_progress_idx + 1
+        )
+    } else {
+        format!(
+            "進度重置到首章：第 {} 章 {}",
+            outcome.new_progress_idx + 1,
+            outcome.new_first_chapter_name
+        )
+    }
+}
+
+/// Chapter-number token regex (REQ-002 rule c). Captures the numeral run
+/// between `第` and a chapter/volume marker (`章回節节卷`); tolerates
+/// optional whitespace on either side of the numeral.
+const CHAPTER_NUMBER_PATTERN: &str =
+    r"第\s*([0-9\u{ff10}-\u{ff19}\u{4e00}\u{4e8c}\u{4e09}\u{56db}\u{4e94}\u{516d}\u{4e03}\u{516b}\u{4e5d}\u{5341}\u{767e}\u{5343}\u{96f6}\u{3007}\u{4e24}\u{5169}]+)\s*[\u{7ae0}\u{56de}\u{7bc0}\u{7bc0}\u{5377}]";
+
+/// Extract the chapter-number token from a chapter name (REQ-002 rule c).
+/// Normalizes fullwidth Arabic digits (０-９) to halfwidth (0-9); Chinese
+/// numerals are kept as-is (same-charset equality only — Arabic<->Chinese
+/// cross-numeral is bonus C15, not required here). Returns `None` when the
+/// name doesn't match the `第...章|回|節|节|卷` pattern at all.
+pub fn extract_chapter_number(name: &str) -> Option<String> {
+    let re = regex::Regex::new(CHAPTER_NUMBER_PATTERN).expect("static regex must compile");
+    let caps = re.captures(name)?;
+    let raw = caps.get(1)?.as_str();
+    let normalized: String = raw
+        .chars()
+        .map(|c| {
+            let cp = c as u32;
+            if (0xFF10..=0xFF19).contains(&cp) {
+                // fullwidth 0-9 -> halfwidth 0-9
+                char::from_u32(cp - 0xFF10 + '0' as u32).unwrap_or(c)
+            } else {
+                c
+            }
+        })
+        .collect();
+    Some(normalized)
+}
+
+/// Best-effort resolve the migrated chapter idx in the new TOC for a known
+/// old chapter name (REQ-002). Precedence, each pass scans `new_toc` in
+/// order and returns on first hit:
+///   a. exact name equality
+///   b. equal after stripping ALL unicode whitespace
+///   c. equal chapter-number token (via [`extract_chapter_number`])
+/// Returns `None` when none of the three rules match (caller should reset).
+/// Pure function — no DB / network access.
+pub fn resolve_migrated_idx(old_name: &str, new_toc: &[ChapterMeta]) -> Option<i64> {
+    // Rule a: exact match.
+    if let Some(row) = new_toc.iter().find(|c| c.name == old_name) {
+        return Some(row.index);
+    }
+
+    // Rule b: equal after stripping ALL unicode whitespace.
+    let strip_ws = |s: &str| -> String { s.chars().filter(|c| !c.is_whitespace()).collect() };
+    let old_stripped = strip_ws(old_name);
+    if let Some(row) = new_toc.iter().find(|c| strip_ws(&c.name) == old_stripped) {
+        return Some(row.index);
+    }
+
+    // Rule c: chapter-number token equal (fullwidth normalized).
+    if let Some(old_num) = extract_chapter_number(old_name) {
+        if let Some(row) = new_toc
+            .iter()
+            .find(|c| extract_chapter_number(&c.name).as_deref() == Some(old_num.as_str()))
+        {
+            return Some(row.index);
+        }
+    }
+
+    None
 }
 
