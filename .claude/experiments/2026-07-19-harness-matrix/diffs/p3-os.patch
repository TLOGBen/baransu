+/// Pure post-pass helper：把同一本書在多個來源的多筆 `HitOrStatus::Hit` 折疊
+/// 成一行（REQ-005）。key = `(name.trim(), author-or-empty.trim())`；同 key
+/// 首次出現時保留該 hit（之後 Enter 都作用在它身上）並記下 output 中的 index，
+/// 重複出現時只把來源名稱 append 進第一筆的 `source_names`（不取代 `hit`）。
+/// `StatusLine` 一律原樣 push、絕不進 key map，位置由掃描順序自然保留
+/// （REQ-005 Scenarios 2/4；C20）。單一線性掃描、不 clone 整個 Vec。
+pub fn fold_hits(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    let mut key_to_idx: std::collections::HashMap<(String, String), usize> =
+        std::collections::HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_names } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                if let Some(&idx) = key_to_idx.get(&key) {
+                    if let HitOrStatus::Hit {
+                        source_names: existing_names,
+                        ..
+                    } = &mut out[idx]
+                    {
+                        existing_names.extend(source_names);
+                    }
+                } else {
+                    key_to_idx.insert(key, out.len());
+                    out.push(HitOrStatus::Hit { hit, source_names });
+                }
+            }
+            HitOrStatus::StatusLine(s) => out.push(HitOrStatus::StatusLine(s)),
+        }
+    }
+    out
