-/// Outcome of a successful source-switch — surfaces what the caller needs to
-/// rebuild its UI (`new_progress_idx`, `chapter_count`, `new_first_chapter_name`).
-#[derive(Debug)]
-pub struct SwitchOutcome {
-    pub new_progress_idx: i64,
-    pub chapter_count: usize,
-    pub new_first_chapter_name: String,
+/// Outcome of a successful source-switch. Distinguishes the two progress paths
+/// so both the CLI handler and the TUI toast can tell the user whether their
+/// reading position was carried over or reset (Item B6).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SwitchOutcome {
+    /// Best-effort progress migration succeeded: the old current chapter matched
+    /// a chapter in the new TOC. `new_idx` is the matched NEW idx (NOT dense —
+    /// taken from the matched chapter's own `.index`).
+    Migrated {
+        new_idx: i64,
+        matched_chapter_name: String,
+    },
+    /// No usable old position, or no chapter matched: progress reset to the new
+    /// TOC's first chapter (idx = new_toc.first().index, scroll = 0) — the
+    /// pre-Item-B behaviour.
+    Reset {
+        new_idx: i64,
+        first_chapter_name: String,
+    },
+}
+
+impl SwitchOutcome {
+    /// The idx to write into `progress.chapter_index` (same on both variants).
+    pub fn new_idx(&self) -> i64 {
+        match self {
+            SwitchOutcome::Migrated { new_idx, .. } | SwitchOutcome::Reset { new_idx, .. } => {
+                *new_idx
+            }
+        }
+    }
+}
+
+/// Strip ALL Unicode whitespace from a name (rule b). `char::is_whitespace`
+/// covers the White_Space property — ASCII space/tab/newline plus the
+/// ideographic space U+3000 that CJK TOCs sprinkle around chapter titles.
+fn strip_all_whitespace(s: &str) -> String {
+    s.chars().filter(|c| !c.is_whitespace()).collect()
+}
+
+/// Normalize full-width Arabic digits (U+FF10..U+FF19) to their half-width
+/// ASCII counterparts; every other char (incl. CJK numerals) passes through.
+fn normalize_fullwidth_digits(s: &str) -> String {
+    s.chars()
+        .map(|c| {
+            if ('０'..='９').contains(&c) {
+                // U+FF10 - U+FEE0 = U+0030 ('0'); the offset is constant across 0-9.
+                char::from_u32(c as u32 - 0xFEE0).unwrap_or(c)
+            } else {
+                c
+            }
+        })
+        .collect()
+}
+
+/// Extract the chapter-number token from a name (rule c). Matches
+/// `第 <num> 章|回|節|节|卷` where `<num>` is Arabic (half/full-width) or CJK
+/// numerals, returning the first capture group with full-width digits
+/// normalized to half-width. `None` if the name has no such token.
+///
+/// Arabic-vs-CJK cross-matching is intentionally NOT done (spec: bonus only) —
+/// "第3章" and "第三章" yield different tokens ("3" vs "三") and do not match.
+fn chapter_number_token(name: &str) -> Option<String> {
+    static RE: OnceLock<Regex> = OnceLock::new();
+    let re = RE.get_or_init(|| {
+        Regex::new(r"第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]")
+            .expect("chapter-number token regex is a valid literal")
+    });
+    let caps = re.captures(name)?;
+    Some(normalize_fullwidth_digits(caps.get(1)?.as_str()))
+}
+
+/// Pure best-effort progress migration (Item B algorithm). Given the OLD TOC,
+/// the OLD `progress.chapter_index` (if any), and the freshly fetched NEW TOC
+/// (guaranteed non-empty by `evaluate_toc`), decide the new reading position.
+///
+/// Precedence is **rule-major**: rule (a) is tried across the whole new TOC
+/// before rule (b), which is tried before rule (c). Within a rule, the first
+/// chapter in ascending-idx order wins. This is the only reading under which
+/// (a) > (b) > (c) is observable — a naive per-chapter a→b→c scan would let an
+/// earlier weak (c) match preempt a later exact (a) match.
+///
+/// Falls back to `Reset` when: no old progress row, the old idx resolves to no
+/// chapter in the old TOC, or no new chapter matches under any rule.
+pub fn migrate_progress(
+    old_toc: &[ChapterMeta],
+    old_progress_idx: Option<i64>,
+    new_toc: &[ChapterMeta],
+) -> SwitchOutcome {
+    let first = new_toc.first().expect("new_toc is non-empty (evaluate_toc)");
+    let reset = || SwitchOutcome::Reset {
+        new_idx: first.index,
+        first_chapter_name: first.name.clone(),
+    };
+
+    // Resolve the OLD current chapter's name (match on .index — idx is sparse).
+    let old_name = match old_progress_idx
+        .and_then(|idx| old_toc.iter().find(|c| c.index == idx))
+        .map(|c| c.name.as_str())
+    {
+        Some(n) => n,
+        None => return reset(),
+    };
+
+    let migrated = |c: &ChapterMeta| SwitchOutcome::Migrated {
+        new_idx: c.index,
+        matched_chapter_name: c.name.clone(),
+    };
+
+    // Rule (a): exact name equality, whole TOC (ascending-idx first wins).
+    if let Some(c) = new_toc.iter().find(|c| c.name == old_name) {
+        return migrated(c);
+    }
+    // Rule (b): equality after stripping all Unicode whitespace.
+    let old_stripped = strip_all_whitespace(old_name);
+    if let Some(c) = new_toc
+        .iter()
+        .find(|c| strip_all_whitespace(&c.name) == old_stripped)
+    {
+        return migrated(c);
+    }
+    // Rule (c): chapter-number token equality (only if the old name has one).
+    if let Some(old_tok) = chapter_number_token(old_name) {
+        if let Some(c) = new_toc
+            .iter()
+            .find(|c| chapter_number_token(&c.name).as_deref() == Some(old_tok.as_str()))
+        {
+            return migrated(c);
+        }
+    }
+
