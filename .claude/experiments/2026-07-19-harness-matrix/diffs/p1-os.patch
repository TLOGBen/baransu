+    }
+
+    /// C3: a collapsed row keeps the list position of its FIRST occurrence;
+    /// a single-source book renders exactly as before (`name / author [src]`).
+    #[test]
+    fn c3_first_occurrence_position_and_single_source_render() {
+        // Book P at position 0, book Q at 1, then a second P hit — P must stay at 0.
+        let rows = vec![
+            hit_row("P", Some("a1"), "http://a", "源A"),
+            hit_row("Q", Some("a2"), "http://b", "源B"),
+            hit_row("P", Some("a1"), "http://c", "源C"),
+        ];
+        let folded = fold_rows(rows);
+        assert_eq!(folded.len(), 2, "P 摺疊、Q 單獨 → 兩列");
+        // P kept its first-occurrence slot (index 0) and now has two sources.
+        match &folded[0] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits[0].0.name, "P");
+                assert_eq!(hits.len(), 2, "P 收攏兩源");
+            }
+            _ => panic!("row 0 應為 P 的 Folded"),
+        }
+        // Q is a single-source Folded → renders like the old un-folded Hit line.
+        match &folded[1] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits.len(), 1);
+                assert_eq!(folded_display(hits), "Q / a2 [源B]");
+            }
+            _ => panic!("row 1 應為 Q 的 Folded"),
+        }
+    }
+
+    /// C4: `hits[0]` is the first source in iteration order — Enter acts on it.
+    #[test]
+    fn c4_folded_first_source_is_iteration_first() {
+        let rows = vec![
+            hit_row("書", Some("作"), "http://first", "源A"),
+            hit_row("書", Some("作"), "http://second", "源B"),
+        ];
+        let folded = fold_rows(rows);
+        match &folded[0] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits[0].0.source_url, "http://first");
+                assert_eq!(hits[0].1, "源A");
+            }
+            _ => panic!("應為 Folded"),
+        }
+    }
+
+    /// C5: StatusLine rows are unaffected and keep their positions relative to
+    /// the surviving (folded) rows.
+    #[test]
+    fn c5_status_lines_keep_relative_positions() {
+        let rows = vec![
+            hit_row("書", Some("作"), "http://a", "源A"),
+            HitOrStatus::StatusLine("源 B：逾時".into()),
+            hit_row("書", Some("作"), "http://c", "源C"), // folds into row 0
+            HitOrStatus::StatusLine("源 D 未查（時間預算用盡）".into()),
+        ];
+        let folded = fold_rows(rows);
+        // book(folded) , timeout-status , notqueried-status  → 3 rows, order kept.
+        assert_eq!(folded.len(), 3);
+        match &folded[0] {
+            HitOrStatus::Folded { hits } => assert_eq!(hits.len(), 2),
+            _ => panic!("row 0 應為摺疊書列"),
+        }
+        match &folded[1] {
+            HitOrStatus::StatusLine(s) => assert!(s.contains("逾時")),
+            _ => panic!("row 1 應保留逾時狀態列"),
+        }
+        match &folded[2] {
+            HitOrStatus::StatusLine(s) => assert!(s.contains("未查")),
+            _ => panic!("row 2 應保留未查狀態列"),
+        }
+    }
+
+    /// Folding keys on TRIMMED name/author — cosmetic whitespace still folds.
+    #[test]
+    fn c_fold_keys_on_trimmed_name_and_author() {
+        let rows = vec![
+            hit_row("  書名  ", Some(" 作者 "), "http://a", "源A"),
+            hit_row("書名", Some("作者"), "http://b", "源B"),
+        ];
+        let folded = fold_rows(rows);
+        assert_eq!(folded.len(), 1, "trim 後同鍵 → 摺疊");
+    }
