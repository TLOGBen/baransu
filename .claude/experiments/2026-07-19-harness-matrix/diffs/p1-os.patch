+/// (format free per C1), e.g. `超維術士 - 牧狐 [3源: A, B, C]`.
+fn folded_display(hits: &[(SearchHit, String)]) -> String {
+    let first = &hits[0].0;
+    let author = first.author.as_deref().unwrap_or("-");
+    if hits.len() == 1 {
+        format!("{} / {} [{}]", first.name, author, hits[0].1)
+    } else {
+        let srcs: Vec<&str> = hits.iter().map(|(_, s)| s.as_str()).collect();
+        format!(
+            "{} - {} [{}源: {}]",
+            first.name,
+            author,
+            hits.len(),
+            srcs.join(", ")
+        )
+    }
+}
