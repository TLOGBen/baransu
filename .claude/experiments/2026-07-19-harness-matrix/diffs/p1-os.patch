+/// Item C — pure post-pass that folds same-book hits into one row.
+///
+/// Two `Hit` rows collapse iff their `(name.trim(), author-or-empty.trim())`
+/// keys are equal (C1); a different name OR author keeps them separate (C2).
+/// The collapsed `Folded` row takes the list position of the book's FIRST
+/// occurrence (C3); source hits accumulate in encounter order so `hits[0]` is
+/// the first source (C4). `StatusLine` rows pass through untouched and keep
+/// their position relative to the surviving rows (C5). A single-source book
+/// still becomes a `Folded` of length 1 — rendered exactly as before (C3).
+///
+/// No scraper / db / clock — unit-testable in isolation (C6).
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::new();
+    // Book key → index of its Folded row in `out`.
+    let mut seen: std::collections::HashMap<(String, String), usize> =
+        std::collections::HashMap::new();
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                if let Some(&i) = seen.get(&key) {
+                    if let HitOrStatus::Folded { hits } = &mut out[i] {
+                        hits.push((hit, source_name));
+                    }
+                } else {
+                    seen.insert(key, out.len());
+                    out.push(HitOrStatus::Folded {
+                        hits: vec![(hit, source_name)],
+                    });
+                }
+            }
+            // StatusLine (and any already-Folded row) pass through in place.
+            other => out.push(other),
+        }
+    }
+    out
+}
