+    }
+
+    #[test]
+    fn display_helper_folded_multi_source_format() {
+        let hit = make_hit_with_author("超維術士", Some("牧狐"), "a");
+        let s = format_hit_row(&hit, "源 A", &["源 B".to_string(), "源 C".to_string()]);
+        assert_eq!(s, "超維術士 - 牧狐 [3源: 源 A, 源 B, 源 C]");
+    }
+
+    #[test]
+    fn draw_calls_the_same_format_hit_row_helper_real_call_path() {
+        // Real-call-path pin: build a Results state via assemble_rows (the
