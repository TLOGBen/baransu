+    // ------------------------------------------------------------------
+    // Item C — multi-source search result folding
+    // ------------------------------------------------------------------
+
+    fn make_hit_with_author(name: &str, author: Option<&str>, src_url: &str) -> SearchHit {
+        SearchHit {
+            source_url: src_url.into(),
+            name: name.into(),
+            author: author.map(str::to_string),
+            book_url: format!("https://example.com/{}/{}", name, src_url),
+            kind: None,
+            intro: None,
+        }
+    }
+
+    #[test]
+    fn c1_same_name_and_author_from_different_sources_collapses_to_one_row() {
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("超維術士", Some("牧狐"), "a")])),
+            ("源 B".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("超維術士", Some("牧狐"), "b")])),
+            ("源 C".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("超維術士", Some("牧狐"), "c")])),
+        ];
+        let rows = assemble_rows(per_source);
+        assert_eq!(rows.len(), 1);
+        match &rows[0] {
+            HitOrStatus::FoldedHit { first, first_source, rest } => {
+                assert_eq!(first.name, "超維術士");
+                assert_eq!(first_source, "源 A");
+                assert_eq!(rest.len(), 2, "3 個來源 → first + 2 rest");
+            }
+            _ => panic!("expected a single FoldedHit row"),
+        }
+    }
+
+    #[test]
+    fn c2_same_name_different_author_stays_separate() {
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("凡人修仙傳", Some("忘語"), "a")])),
+            ("源 B".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("凡人修仙傳", Some("其他作者"), "b")])),
+        ];
+        let rows = assemble_rows(per_source);
+        assert_eq!(rows.len(), 2, "作者不同 → 不摺疊，各自成行");
+        assert!(matches!(rows[0], HitOrStatus::Hit { .. }));
+        assert!(matches!(rows[1], HitOrStatus::Hit { .. }));
+    }
+
+    #[test]
+    fn c2_none_and_some_empty_author_collapse_together() {
+        // C2 "depends inversely": None and Some("") must be treated as the SAME
+        // author key (both fold to "") so they DO collapse.
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", None, "a")])),
+            ("源 B".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some(""), "b")])),
+            ("源 C".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some("   "), "c")])),
+        ];
+        let rows = assemble_rows(per_source);
+        assert_eq!(rows.len(), 1, "None / Some(\"\") / Some(全空白) 三者視為同一 author key");
+        assert!(matches!(rows[0], HitOrStatus::FoldedHit { .. }));
+    }
+
+    #[test]
+    fn c3_collapsed_row_keeps_first_occurrence_slot() {
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書甲", Some("x"), "a")])),
+            ("源 B".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書乙", Some("y"), "b")])),
+            ("源 C".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書甲", Some("x"), "c")])),
+        ];
+        let rows = assemble_rows(per_source);
+        assert_eq!(rows.len(), 2, "書甲(A,C) 摺疊 + 書乙(B) 各自一行");
+        // 書甲's collapsed row sits at slot 0 (A's first-occurrence slot), not at
+        // C's later position — 書乙 (from B) stays at slot 1.
+        match &rows[0] {
+            HitOrStatus::FoldedHit { first, .. } => assert_eq!(first.name, "書甲"),
+            _ => panic!("expected 書甲's FoldedHit at slot 0 (first-occurrence)"),
+        }
+        match &rows[1] {
+            HitOrStatus::Hit { hit, .. } => assert_eq!(hit.name, "書乙"),
+            _ => panic!("expected 書乙's Hit at slot 1"),
+        }
+    }
+
+    #[test]
+    fn c4_enter_on_folded_row_resolves_to_first_source_hit() {
+        // Pure-logic level: the FoldedHit variant itself carries `first` as the
+        // first-seen hit — the same value the real Enter handler extracts
+        // (see handle_event's KeyCode::Enter match arm).
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some("作者"), "a")])),
+            ("源 B".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some("作者"), "b")])),
+        ];
+        let rows = assemble_rows(per_source);
+        match &rows[0] {
+            HitOrStatus::FoldedHit { first, first_source, .. } => {
+                assert_eq!(first_source, "源 A");
+                assert_eq!(first.source_url, "a", "first must be源 A's hit, not 源 B's");
+            }
+            _ => panic!("expected FoldedHit"),
+        }
+    }
+
+    #[test]
+    fn c5_status_lines_survive_folding_in_original_relative_position() {
+        // StatusLine interleaved BETWEEN two duplicates (per contract: "C5 test
+        // MUST interleave a StatusLine between two duplicates").
+        let per_source = vec![
+            ("源 A".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some("作者"), "a")])),
+            ("源 B".to_string(), SourceOutcome::ScrapeErr("規則寫錯".into())),
+            ("源 C".to_string(), SourceOutcome::Hits(vec![make_hit_with_author("書名", Some("作者"), "c")])),
+            ("源 D".to_string(), SourceOutcome::Timeout),
+        ];
+        let rows = assemble_rows(per_source);
+        assert_eq!(rows.len(), 3, "A+C 摺疊為一行 + B 錯誤列 + D 逾時列");
+        assert!(matches!(rows[0], HitOrStatus::FoldedHit { .. }), "row 0: A+C 摺疊");
+        match &rows[1] {
+            HitOrStatus::StatusLine(s) => assert!(s.contains("源 B") && s.contains("錯誤")),
+            _ => panic!("row 1 應為源 B 的 StatusLine，保持在摺疊列之後的相對位置"),
+        }
+        match &rows[2] {
+            HitOrStatus::StatusLine(s) => assert!(s.contains("源 D") && s.contains("逾時")),
+            _ => panic!("row 2 應為源 D 的 StatusLine"),
+        }
+    }
+
