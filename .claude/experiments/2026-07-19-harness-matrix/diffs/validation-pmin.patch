+/// Pure post-pass over `assemble_rows`' output: collapse `Hit` rows sharing a
+/// [`fold_key`] into one `FoldedHit`, order-preserving.
+///
+/// - A collapsed row sits at its FIRST occurrence's slot (C3) — later
+///   duplicate `Hit` rows are merged into that slot, not appended, so no new
+///   slot is created for them.
+/// - `StatusLine` rows are never touched and keep their position relative to
+///   the surviving rows (C5) — folding only ever rewrites a `Hit` slot into a
+///   `FoldedHit` in place, it never removes or reorders anything else.
+pub fn fold_duplicate_hits(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    let mut index_by_key: std::collections::HashMap<(String, String), usize> =
+        std::collections::HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::StatusLine(s) => out.push(HitOrStatus::StatusLine(s)),
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = fold_key(&hit);
+                if let Some(&idx) = index_by_key.get(&key) {
+                    match &mut out[idx] {
+                        HitOrStatus::Hit { hit: first_hit, source_name: first_source } => {
+                            out[idx] = HitOrStatus::FoldedHit {
+                                first: first_hit.clone(),
+                                first_source: first_source.clone(),
+                                rest: vec![(hit, source_name)],
+                            };
+                        }
+                        HitOrStatus::FoldedHit { rest, .. } => {
+                            rest.push((hit, source_name));
+                        }
+                        HitOrStatus::StatusLine(_) => {
+                            unreachable!("index_by_key only ever records Hit/FoldedHit slots")
+                        }
+                    }
+                } else {
+                    index_by_key.insert(key, out.len());
+                    out.push(HitOrStatus::Hit { hit, source_name });
+                }
+            }
+            // Not produced by assemble_rows before folding; pass through
+            // defensively (idempotent under re-folding).
+            already @ HitOrStatus::FoldedHit { .. } => out.push(already),
+        }
+    }
