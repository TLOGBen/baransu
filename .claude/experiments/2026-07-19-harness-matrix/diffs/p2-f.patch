+/// Rule (b) normalizer: strip ALL Unicode whitespace (U+3000 ideographic
+/// space included — `char::is_whitespace` covers it).
+fn strip_all_whitespace(s: &str) -> String {
+    s.chars().filter(|c| !c.is_whitespace()).collect()
+}
