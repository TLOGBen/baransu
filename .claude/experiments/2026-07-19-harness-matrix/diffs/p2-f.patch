+/// Rule (c) token extractor: first capture group, fullwidth digits ０-９
+/// normalized to halfwidth. No cross-conversion between Chinese numerals and
+/// Arabic digits — `十二` stays `十二` and never equals `12` (brief rule c).
+fn extract_chapter_no(name: &str) -> Option<String> {
+    let caps = chapter_no_regex().captures(name)?;
+    let token = caps.get(1)?.as_str();
+    Some(
+        token
+            .chars()
+            .map(|c| match c {
