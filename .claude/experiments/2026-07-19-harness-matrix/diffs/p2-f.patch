+/// Pure selection rule for Enter on a Results row (2026-07-19 REQ-007):
+/// `Hit` acts on its own hit; `FoldedHit` acts on the FIRST source's hit
+/// (`hits[0]`, source-iteration order); `StatusLine` is a no-op.
+fn hit_for_enter(row: &HitOrStatus) -> Option<SearchHit> {
+    match row {
+        HitOrStatus::Hit { hit, .. } => Some(hit.clone()),
+        HitOrStatus::FoldedHit { hits } => hits.first().map(|(h, _)| h.clone()),
+        HitOrStatus::StatusLine(_) => None,
+    }
+}
