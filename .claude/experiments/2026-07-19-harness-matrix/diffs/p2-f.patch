+/// Rule (c) chapter-number regex, compiled once. Literal fixed by the brief.
+fn chapter_no_regex() -> &'static Regex {
+    static RE: OnceLock<Regex> = OnceLock::new();
+    RE.get_or_init(|| {
+        Regex::new("第\\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\\s*[章回節节卷]")
