+/// Pure post-pass over `assemble_rows` output (2026-07-19 REQ-006/007):
+/// fold Hit rows whose `(name.trim(), author-or-empty.trim())` key is equal
+/// into ONE `FoldedHit` row.
+///
+/// Rules:
+/// - A folded row keeps the list position of its FIRST occurrence; the fold
+///   order inside `hits` is the source-iteration order (`hits[0]` = first).
+/// - `StatusLine` rows pass through untouched — never merged, never moved
+///   relative to surviving rows.
+/// - A single-source Hit stays a `Hit` (rendered exactly as today).
+/// - `author: None`, `Some("")` and whitespace-only authors share one key.
+///
+/// Builds a fresh Vec — the input is consumed, never mutated in place.
+pub fn fold_hit_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    use std::collections::HashMap;
+
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    let mut index_of: HashMap<(String, String), usize> = HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                match index_of.get(&key).copied() {
+                    None => {
+                        index_of.insert(key, out.len());
+                        out.push(HitOrStatus::Hit { hit, source_name });
+                    }
+                    Some(i) => match &mut out[i] {
+                        slot @ HitOrStatus::Hit { .. } => {
+                            // Upgrade first occurrence in place: Hit → FoldedHit.
+                            let prev = std::mem::replace(
+                                slot,
+                                HitOrStatus::StatusLine(String::new()),
+                            );
+                            let HitOrStatus::Hit { hit: h0, source_name: s0 } = prev else {
+                                unreachable!("slot matched Hit above");
+                            };
+                            *slot = HitOrStatus::FoldedHit {
+                                hits: vec![(h0, s0), (hit, source_name)],
+                            };
+                        }
+                        HitOrStatus::FoldedHit { hits } => hits.push((hit, source_name)),
+                        HitOrStatus::StatusLine(_) => {
+                            unreachable!("index_of only ever points at Hit/FoldedHit")
+                        }
+                    },
+                }
+            }
+            // StatusLine (and any pre-folded row) passes through in position.
+            other => out.push(other),
+        }
+    }
+    out
+}
