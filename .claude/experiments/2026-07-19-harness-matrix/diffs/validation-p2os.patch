+// Item C — cross-source duplicate folding (REQ-005 / brief:C1-C6)
+// ----------------------------------------------------------------------------
+
+/// Fold key — copied verbatim from design.md `## Verbatim Constants`:
+/// `(hit.name.trim(), hit.author.as_deref().unwrap_or("").trim())`.
+fn fold_key(hit: &SearchHit) -> (&str, &str) {
+    (hit.name.trim(), hit.author.as_deref().unwrap_or("").trim())
+}
+
+/// Pure post-pass (brief:C6): folds rows whose `(name, author)` key matches
+/// into a single `FoldedHit`, keeping the first-occurrence position and
+/// leaving `StatusLine` rows untouched at their original relative position.
+/// Does NOT rewrite `assemble_rows`'s existing semantics — single-source rows
+/// still render as `Hit` (C17).
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    // Maps a fold key to the index in `out` holding that key's row (Hit or
+    // already-folded FoldedHit), so subsequent duplicates merge in-place at
+    // the first-occurrence slot.
+    let mut key_to_out_idx: std::collections::HashMap<(String, String), usize> =
+        std::collections::HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = {
+                    let (n, a) = fold_key(&hit);
+                    (n.to_string(), a.to_string())
+                };
+                if let Some(&idx) = key_to_out_idx.get(&key) {
+                    // Merge into the existing first-occurrence slot, upgrading
+                    // it to FoldedHit if it was still a plain Hit.
+                    let is_plain_hit = matches!(out[idx], HitOrStatus::Hit { .. });
+                    if is_plain_hit {
+                        let first =
+                            std::mem::replace(&mut out[idx], HitOrStatus::StatusLine(String::new()));
+                        let HitOrStatus::Hit { hit: first_hit, source_name: first_src } = first
+                        else {
+                            unreachable!()
+                        };
+                        out[idx] = HitOrStatus::FoldedHit {
+                            hits: vec![(first_hit, first_src), (hit, source_name)],
+                        };
+                    } else if let HitOrStatus::FoldedHit { hits } = &mut out[idx] {
+                        hits.push((hit, source_name));
+                    }
+                } else {
+                    key_to_out_idx.insert(key, out.len());
+                    out.push(HitOrStatus::Hit { hit, source_name });
+                }
+            }
+            // StatusLine rows never participate in folding and keep their
+            // original relative position among the surviving rows.
+            other @ HitOrStatus::StatusLine(_) => out.push(other),
+            // fold_rows only ever consumes assemble_rows output, which never
+            // produces FoldedHit — but handle it for defensiveness/idempotence.
+            other @ HitOrStatus::FoldedHit { .. } => out.push(other),
+        }
+    }
+    out
+}
+
+/// Display text for a folded row (brief:C1): must contain the book name,
+/// author, source count, and every source name. Format is free-form.
+fn folded_display_text(hits: &[(SearchHit, String)]) -> String {
+    let (name, author) = hits
+        .first()
+        .map(|(h, _)| fold_key(h))
+        .unwrap_or(("", ""));
+    let author_display = if author.is_empty() { "-" } else { author };
+    let source_names: Vec<&str> = hits.iter().map(|(_, s)| s.as_str()).collect();
+    format!(
+        "{} - {} [{}源: {}]",
+        name,
+        author_display,
+        hits.len(),
+        source_names.join(", ")
+    )
 }
 
