+/// Three-tier chapter-name match (REQ-003 / C7–C10): rule a (exact) > rule b
+/// (whitespace-stripped equality) > rule c (chapter-number token equality,
+/// fullwidth→halfwidth normalised). Ascending scan over `toc`; highest-
+/// precedence rule wins. Returns the matched entry's `ChapterMeta.index`
+/// (never its Vec position — idx is non-dense).
+fn match_chapter(old: &str, toc: &[ChapterMeta]) -> Option<i64> {
+    if old.is_empty() {
+        return None;
+    }
+
+    // rule a: exact equality.
+    for c in toc {
+        if c.name == old {
+            return Some(c.index);
+        }
+    }
+
+    // rule b: strip all Unicode whitespace, then compare.
+    let strip_ws = |s: &str| -> String { s.chars().filter(|c| !c.is_whitespace()).collect() };
+    let old_stripped = strip_ws(old);
+    for c in toc {
+        if strip_ws(&c.name) == old_stripped {
+            return Some(c.index);
+        }
+    }
