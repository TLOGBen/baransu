+    let chapter_token = |s: &str| -> Option<String> {
+        CHAPTER_NUM_RE.captures(s).map(|cap| {
+            cap[1].chars().map(fullwidth_to_halfwidth_digit).collect::<String>()
+        })
+    };
+    if let Some(old_token) = chapter_token(old) {
+        for c in toc {
