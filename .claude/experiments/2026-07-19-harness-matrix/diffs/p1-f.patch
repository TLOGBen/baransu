+    fn c1_same_book_three_sources_folds_to_one_row() {
+        let rows = fold_rows(vec![
+            hit_row("超維術士", Some("牧狐"), "源 A", "http://a"),
+            hit_row("超維術士", Some("牧狐"), "源 B", "http://b"),
+            hit_row("超維術士", Some("牧狐"), "源 C", "http://c"),
+        ]);
+        assert_eq!(rows.len(), 1, "三源同書必須摺疊成一行");
+        let label = row_label(&rows[0]);
+        assert!(label.contains("超維術士"), "label 應含書名: {label}");
+        assert!(label.contains("牧狐"), "label 應含作者: {label}");
+        assert!(label.contains("3源"), "label 應含源數: {label}");
+        for s in ["源 A", "源 B", "源 C"] {
+            assert!(label.contains(s), "label 應列出全部源名 ({s}): {label}");
+        }
+    }
+
+    /// C1 邊界：name/author 帶前後空白仍視為同書（trim 後比對）。
+    #[test]
+    fn c1_fold_key_trims_name_and_author() {
+        let rows = fold_rows(vec![
+            hit_row(" 超維術士 ", Some("牧狐"), "源 A", "http://a"),
+            hit_row("超維術士", Some(" 牧狐 "), "源 B", "http://b"),
+        ]);
+        assert_eq!(rows.len(), 1, "trim 後相同 → 摺疊");
+        assert!(matches!(&rows[0], HitOrStatus::Folded { hits } if hits.len() == 2));
+    }
+
+    /// C2: 同名不同作者（含 None author）→ 不摺疊。
+    #[test]
+    fn c2_same_name_different_author_stays_separate() {
+        let rows = fold_rows(vec![
+            hit_row("同名書", Some("作者甲"), "源 A", "http://a"),
+            hit_row("同名書", Some("作者乙"), "源 B", "http://b"),
+            hit_row("同名書", None, "源 C", "http://c"),
+        ]);
+        assert_eq!(rows.len(), 3, "author 不同（或缺）不得摺疊");
+        for r in &rows {
+            assert!(matches!(r, HitOrStatus::Hit { .. }), "全部應維持單源 Hit 行");
+        }
+    }
+
+    /// C3 + C5: 摺疊行停在第一次出現的位置；StatusLine 相對倖存行位置不變；
+    /// 單源 hit 的 label 與摺疊功能之前一致。
+    #[test]
+    fn c3_c5_positions_and_single_row_rendering() {
+        let rows = fold_rows(vec![
+            hit_row("書X", Some("甲"), "源 A", "http://a"),
+            HitOrStatus::StatusLine("源 B：逾時".into()),
+            hit_row("書Y", Some("乙"), "源 C", "http://c"),
+            hit_row("書X", Some("甲"), "源 D", "http://d"),
+        ]);
+        assert_eq!(rows.len(), 3, "書X 兩行摺疊後剩 3 行");
+        // row 0: 摺疊的書X，佔第一次出現的位置。
+        match &rows[0] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits.len(), 2);
+                assert_eq!(hits[0].1, "源 A", "hits[0] 是第一個出現的源");
+                assert_eq!(hits[1].1, "源 D");
+            }
+            other => panic!("row 0 應為 Folded，得 {}", row_label(other)),
+        }
+        // row 1: StatusLine 原文、位置緊跟在倖存行後（C5）。
+        match &rows[1] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "源 B：逾時"),
+            other => panic!("row 1 應為 StatusLine，得 {}", row_label(other)),
+        }
+        // row 2: 單源書Y 維持 Hit、label 格式與既有一致（C3）。
+        assert!(matches!(&rows[2], HitOrStatus::Hit { .. }));
+        assert_eq!(row_label(&rows[2]), "書Y / 乙 [源 C]");
+    }
+
+    /// C4: Enter 落在摺疊行 → 作用於第一個源的 hit。in-memory db 無該書源，
+    /// add 流程會 append「找不到書源：<url>」狀態行 — 斷言其為第一源的 URL。
+    #[tokio::test]
+    async fn c4_enter_on_folded_row_acts_on_first_source_hit() {
+        let mut s = SearchScreen::new();
+        let mut ctx = test_ctx();
+        let folded = fold_rows(vec![
+            hit_row("書X", Some("甲"), "源 A", "http://first.example"),
+            hit_row("書X", Some("甲"), "源 B", "http://second.example"),
+        ]);
+        let mut list_state = ListState::default();
+        list_state.select(Some(0));
+        s.state = SearchState::Results { rows: folded, list_state };
+
+        let t = s.handle_event(press(KeyCode::Enter), &mut ctx).await;
+        assert!(matches!(t, Transition::Stay), "找不到書源 → Stay 並 append 狀態行");
+        let SearchState::Results { rows, .. } = &s.state else {
+            panic!("應仍在 Results 狀態");
+        };
+        let last = row_label(rows.last().expect("應有 append 的狀態行"));
+        assert!(
+            last.contains("找不到書源"),
+            "應走到 add 流程的書源查找: {last}"
+        );
+        assert!(
+            last.contains("http://first.example"),
+            "Enter 必須作用於第一源（源 A）的 hit: {last}"
+        );
+    }
