+
+/// Pure post-pass over [`assemble_rows`] output（Item C）：把 fold key 相同的
+/// `Hit` 行摺疊成一個 [`HitOrStatus::Folded`]。
+///
+/// 規則：
+/// - C1: 相同 `(name.trim(), author.trim())` 的 hit 收斂成一行；
+/// - C2: name 或 author 任一不同 → 各自成行；
+/// - C3: 摺疊行停留在「第一次出現」的位置；單源 hit 維持原樣（仍是 `Hit`）；
+/// - C5: `StatusLine` 行不受影響，相對順序不變。
+///
+/// 純函數：不碰 scraper / db / 時鐘。
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    use std::collections::HashMap;
+
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    let mut first_pos: HashMap<(String, String), usize> = HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = fold_key(&hit);
+                if let Some(&i) = first_pos.get(&key) {
+                    // Upgrade the first occurrence in place (position preserved).
+                    let prev = std::mem::replace(
+                        &mut out[i],
+                        HitOrStatus::StatusLine(String::new()), // placeholder, replaced below
+                    );
+                    out[i] = match prev {
+                        HitOrStatus::Hit { hit: h0, source_name: s0 } => HitOrStatus::Folded {
+                            hits: vec![(h0, s0), (hit, source_name)],
+                        },
+                        HitOrStatus::Folded { mut hits } => {
+                            hits.push((hit, source_name));
+                            HitOrStatus::Folded { hits }
+                        }
+                        other => other, // unreachable: first_pos only indexes Hit/Folded
+                    };
+                } else {
+                    first_pos.insert(key, out.len());
+                    out.push(HitOrStatus::Hit { hit, source_name });
+                }
+            }
+            other => out.push(other),
+        }
+    }
+    out
+}
