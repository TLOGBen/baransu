+/// Chapter-number token regex (fixed by spec): captures the numeral run in
+/// e.g. 「第12章」「第 一百零三 回」. First capture group is the token.
+const CHAPTER_NO_PATTERN: &str =
+    r"第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]";
+
+/// Strip ALL Unicode whitespace (rule b normalization).
+fn strip_unicode_ws(s: &str) -> String {
+    s.chars().filter(|c| !c.is_whitespace()).collect()
+}
+
+/// Normalize full-width digits (０-９) to ASCII; other chars pass through.
+/// Arabic-vs-Chinese-numeral cross-matching is intentionally NOT done (spec:
+/// tokens compare as strings after this normalization only).
+fn normalize_fullwidth_digits(s: &str) -> String {
+    s.chars()
+        .map(|c| match c {
+            '０'..='９' => char::from_u32(c as u32 - '０' as u32 + '0' as u32).unwrap_or(c),
+            other => other,
+        })
+        .collect()
+}
+
+/// Extract the normalized chapter-number token from a chapter name, if any.
+fn chapter_number_token(re: &Regex, name: &str) -> Option<String> {
+    re.captures(name)
+        .and_then(|c| c.get(1))
+        .map(|m| normalize_fullwidth_digits(m.as_str()))
+}
+
+/// Best-effort migration target lookup (Item B step 2). Scans `new_toc` in
+/// order (ascending idx as stored); the first chapter satisfying the
+/// HIGHEST-precedence rule wins:
+///   a. exact name equality
+///   b. equality after stripping all Unicode whitespace from both names
+///   c. chapter-number token equality (regex above, full-width normalized)
+///
+/// Returns `None` when no rule matches → caller falls back to reset.
+pub fn find_migration_target<'a>(
+    old_name: &str,
+    new_toc: &'a [ChapterMeta],
+) -> Option<&'a ChapterMeta> {
+    // rule a: exact equality
+    if let Some(c) = new_toc.iter().find(|c| c.name == old_name) {
+        return Some(c);
+    }
+    // rule b: whitespace-stripped equality
+    let old_stripped = strip_unicode_ws(old_name);
+    if let Some(c) = new_toc.iter().find(|c| strip_unicode_ws(&c.name) == old_stripped) {
+        return Some(c);
+    }
+    // rule c: chapter-number token equality
+    let re = Regex::new(CHAPTER_NO_PATTERN).expect("CHAPTER_NO_PATTERN is a valid regex");
+    let old_token = chapter_number_token(&re, old_name)?;
+    new_toc
+        .iter()
+        .find(|c| chapter_number_token(&re, &c.name).as_deref() == Some(old_token.as_str()))
 }
 
