+/// Pure post-pass (REQ-008): fold `Hit` rows whose `(name.trim(), author-or-
+/// empty.trim())` are equal into a single `FoldedHit`, preserving the first
+/// occurrence's list position. `StatusLine` rows pass through untouched at
+/// their original position (C19). Deliberately NOT merged into `assemble_rows`
+/// — `req003_scenario1_three_sources_all_hit` feeds 3 identical-key hits and
+/// asserts `rows.len() == 3`; folding there would break that passing test
+/// (see decision log / task-c.md).
+pub fn fold_duplicate_hits(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::new();
+    let mut slot_of: std::collections::HashMap<(String, String), usize> =
+        std::collections::HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::StatusLine(_) => out.push(row),
+            HitOrStatus::FoldedHit { .. } => out.push(row), // not produced pre-fold; pass through defensively
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                match slot_of.get(&key) {
+                    None => {
+                        slot_of.insert(key, out.len());
+                        out.push(HitOrStatus::Hit { hit, source_name });
+                    }
+                    Some(&idx) => {
+                        // Upgrade the existing slot to FoldedHit if it isn't already.
+                        let existing = std::mem::replace(&mut out[idx], HitOrStatus::StatusLine(String::new()));
+                        let mut sources = match existing {
+                            HitOrStatus::Hit { hit: h, source_name: s } => vec![(s, h)],
+                            HitOrStatus::FoldedHit { sources } => sources,
+                            other => {
+                                // Should never happen — key map only ever points at Hit/FoldedHit slots.
+                                out[idx] = other;
+                                continue;
+                            }
+                        };
+                        sources.push((source_name, hit));
+                        out[idx] = HitOrStatus::FoldedHit { sources };
+                    }
+                }
+            }
+        }
+    }
+    out
+}
