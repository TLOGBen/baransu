+    /// C19: StatusLine 相對存活列的位置在摺疊後保留。
+    #[test]
+    fn fold_preserves_status_line_relative_position() {
+        let rows = vec![
+            hit_row("X", Some("a"), "源A"),
+            HitOrStatus::StatusLine("源 B：逾時".to_string()),
+            hit_row("X", Some("a"), "源C"),
+        ];
+        let out = fold_duplicate_hits(rows);
+        // [FoldedHit(X/a, 源A+源C), StatusLine] — 摺疊在首次出現位置(0)，
+        // StatusLine 保留其相對存活列的位置（在摺疊列之後）。
+        assert_eq!(out.len(), 2);
+        assert!(matches!(&out[0], HitOrStatus::FoldedHit { sources } if sources.len() == 2));
+        match &out[1] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "源 B：逾時"),
+            _ => panic!("StatusLine 應仍存在且未被摺疊邏輯吃掉"),
+        }
+    }
+
+    /// C18: 對 FoldedHit 抽取 Enter 目標 → 第一來源（hitA，非 hitB）。
+    #[test]
+    fn folded_hit_enter_extraction_targets_first_source() {
+        let mut hit_a = make_hit_author("同名書", Some("同作者"), "源A");
+        hit_a.book_url = "https://a.example/book".to_string();
+        let mut hit_b = make_hit_author("同名書", Some("同作者"), "源B");
+        hit_b.book_url = "https://b.example/book".to_string();
+        let row = HitOrStatus::FoldedHit {
+            sources: vec![("源A".to_string(), hit_a.clone()), ("源B".to_string(), hit_b.clone())],
+        };
+        // Mirror the Enter-selection match arm in `handle_event`.
+        let selected = match &row {
+            HitOrStatus::Hit { hit, .. } => Some(hit.clone()),
+            HitOrStatus::FoldedHit { sources } => sources.first().map(|(_, hit)| hit.clone()),
+            HitOrStatus::StatusLine(_) => None,
+        };
+        let selected = selected.expect("FoldedHit must yield a selection");
+        assert_eq!(selected.book_url, hit_a.book_url);
+        assert_ne!(selected.book_url, hit_b.book_url);
+    }
