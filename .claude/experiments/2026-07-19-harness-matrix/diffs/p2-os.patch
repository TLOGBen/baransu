+    let caps = re.captures(name)?;
+    let raw = caps.get(1)?.as_str();
+    let normalized: String = raw
+        .chars()
+        .map(|c| {
+            if ('\u{ff10}'..='\u{ff19}').contains(&c) {
+                // Full-width '０'-'９' -> half-width '0'-'9'.
+                char::from_u32(c as u32 - 0xff10 + '0' as u32).unwrap_or(c)
+            } else {
