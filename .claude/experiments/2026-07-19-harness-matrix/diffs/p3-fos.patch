+/// REQ-003 best-effort progress migration result.
+#[derive(Debug, Clone, PartialEq)]
+pub enum ProgressMigration {
+    /// Old chapter name matched a chapter in the new TOC — progress carried
+    /// forward to that chapter's idx.
+    Migrated { idx: i64, chapter_name: String },
+    /// No match (or no prior progress / unparseable old name) — progress
+    /// reset to the new TOC's first chapter, exactly as today's behaviour.
+    Reset { first_idx: i64, first_chapter_name: String },
