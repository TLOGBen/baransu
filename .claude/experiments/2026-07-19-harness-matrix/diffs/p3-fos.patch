+/// three passes (rule a fully, then rule b fully, then rule c fully) —
+/// exact match always outranks a whitespace-normalized match, which always
+/// outranks a chapter-number-token match, regardless of idx. Within a rule,
+/// the first (lowest-idx) hit wins.
+pub fn match_chapter<'a>(old_name: &str, new_toc: &'a [ChapterMeta]) -> Option<&'a ChapterMeta> {
+    // rule a: exact equality.
+    if let Some(c) = new_toc.iter().find(|c| c.name == old_name) {
