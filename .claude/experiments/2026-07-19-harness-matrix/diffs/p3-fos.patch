+/// Normalize fullwidth digits (U+FF10..U+FF19, "０"-"９") to their halfwidth
+/// ASCII equivalents. Leaves all other characters untouched.
+fn normalize_fullwidth_digits(s: &str) -> String {
+    s.chars()
+        .map(|c| {
+            let cp = c as u32;
+            if (0xFF10..=0xFF19).contains(&cp) {
+                char::from_u32(cp - 0xFF10 + '0' as u32).unwrap_or(c)
+            } else {
+                c
+            }
+        })
+        .collect()
