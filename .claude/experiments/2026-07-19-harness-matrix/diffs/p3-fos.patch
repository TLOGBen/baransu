+    }
+    // rule b: equal after stripping all Unicode whitespace.
+    let old_stripped = strip_all_whitespace(old_name);
+    if let Some(c) = new_toc
+        .iter()
+        .find(|c| strip_all_whitespace(&c.name) == old_stripped)
+    {
+        return Some(c);
+    }
+    // rule c: chapter-number token equality.
+    if let Some(old_token) = chapter_num_token(old_name) {
+        if let Some(c) = new_toc
+            .iter()
+            .find(|c| chapter_num_token(&c.name).as_deref() == Some(old_token.as_str()))
+        {
+            return Some(c);
+        }
+    }
