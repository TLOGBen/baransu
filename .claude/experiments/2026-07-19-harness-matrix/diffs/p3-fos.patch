+/// Pure post-pass：把 `assemble_rows` 輸出中「同一本書在多源命中」的
+/// `HitOrStatus::Hit` 摺疊為一行（legado 聚合行為，REQ-006）。
+///
+/// Key = `(hit.name.trim(), hit.author.as_deref().unwrap_or("").trim())` ——
+/// `author: None` 與 `author: Some("")` 視為同一 key（author-or-empty 語意）。
+/// 相同 key 的 Hit 摺疊到「首次出現」列（該列保留第一筆 hit == 首源，供
+/// Enter 分支撿取，REQ-007）；`source_name` 依源數改寫：N == 1 原樣不動，
+/// N > 1 改為 `"{N}源: {names.join(", ")}"`（源名去重、依出現順序）。
+/// `HitOrStatus::StatusLine` 原樣通過、相對順序不變（C19）。
+///
+/// 不改 `HitOrStatus` 型別、不改 `assemble_rows`——獨立單次掃描 pass，
+/// 故 `assemble_rows` 既有測試不受影響（C20）。
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    use std::collections::HashMap;
+
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    // key -> (index in out, source names seen so far, in order, deduped)
+    let mut key_index: HashMap<(String, String), (usize, Vec<String>)> = HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                if let Some((idx, names)) = key_index.get_mut(&key) {
+                    if !names.contains(&source_name) {
+                        names.push(source_name);
+                    }
+                    if names.len() > 1 {
+                        let new_source_name = format!("{}源: {}", names.len(), names.join(", "));
+                        if let HitOrStatus::Hit { source_name: sn, .. } = &mut out[*idx] {
+                            *sn = new_source_name;
+                        }
+                    }
+                } else {
