+    s.chars().filter(|c| !c.is_whitespace()).collect()
+}
+
+/// Extract the chapter-number token from a chapter name, e.g.
+/// "第１２章 風起" -> Some("12"), "第12回" -> Some("12"), "第三章" -> Some("三").
+/// Returns `None` if the name has no recognizable "第...章/回/節/节/卷" pattern.
+///
+/// Regex is compiled once via `OnceLock` — this fn is called per-candidate
+/// during `match_chapter`'s rule-c scan, so we avoid recompiling per call.
+fn chapter_num_token(name: &str) -> Option<String> {
+    use std::sync::OnceLock;
+    static RE: OnceLock<regex::Regex> = OnceLock::new();
+    let re = RE.get_or_init(|| {
+        regex::Regex::new(r"第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]")
