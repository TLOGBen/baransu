+/// TASK-b-04 — format a human-readable message for a `SwitchOutcome`, shared
+/// by both the CLI handler and the TUI toast (REQ-005 presentation).
+pub fn format_switch_message(outcome: &SwitchOutcome) -> String {
+    match &outcome.migration {
+        ProgressMigration::Migrated { chapter_name, .. } => {
+            format!("進度已遷移：{}", chapter_name)
+        }
+        ProgressMigration::Reset { first_chapter_name, .. } => {
+            format!("進度重置到首章：{}", first_chapter_name)
+        }
+    }
