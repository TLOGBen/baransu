+    fn c3_folded_row_keeps_first_occurrence_position_and_single_source_label_unchanged() {
+        let rows = vec![
+            HitOrStatus::Hit {
+                hit: make_hit("孤書", "http://solo"),
+                source_name: "源 Z".to_string(),
+                co_sources: Vec::new(),
+            },
+            HitOrStatus::Hit {
+                hit: make_hit("重複書", "http://a"),
+                source_name: "源 A".to_string(),
+                co_sources: Vec::new(),
+            },
+            HitOrStatus::Hit {
+                hit: make_hit("重複書", "http://b"),
+                source_name: "源 B".to_string(),
+                co_sources: Vec::new(),
+            },
+        ];
+        let folded = fold_rows(rows);
+        assert_eq!(folded.len(), 2, "「孤書」+ 折疊後的「重複書」共兩行");
+
+        // Index 0 stays the first-occurrence "孤書" row, untouched single-source.
+        match &folded[0] {
+            HitOrStatus::Hit {
+                hit,
+                source_name,
+                co_sources,
+            } => {
+                assert!(co_sources.is_empty());
+                let label = hit_row_label(hit, source_name, co_sources);
+                assert_eq!(label, "孤書 / 作者 [源 Z]", "單源格式應與今日完全相同");
+            }
+            HitOrStatus::StatusLine(_) => panic!("expected Hit"),
+        }
+        // Index 1 is the folded "重複書" row (first occurrence was at rows[1]).
+        match &folded[1] {
+            HitOrStatus::Hit {
+                source_name,
+                co_sources,
+                ..
+            } => {
+                assert_eq!(source_name, "源 A");
+                assert_eq!(co_sources.len(), 1);
+            }
+            HitOrStatus::StatusLine(_) => panic!("expected Hit"),
+        }
+    }
+
+    /// C5: [Hit X@A, StatusLine, Hit X@B, Hit Y@C] folds to
+    /// [FoldedX, StatusLine, Hit Y] — exact positions, StatusLine text unchanged.
+    #[test]
+    fn c5_status_line_keeps_relative_position_among_surviving_rows() {
+        let rows = vec![
+            HitOrStatus::Hit {
+                hit: make_hit("X", "http://a"),
+                source_name: "源 A".to_string(),
+                co_sources: Vec::new(),
+            },
+            HitOrStatus::StatusLine("源 M：錯誤 逾時".to_string()),
+            HitOrStatus::Hit {
+                hit: make_hit("X", "http://b"),
+                source_name: "源 B".to_string(),
+                co_sources: Vec::new(),
+            },
+            HitOrStatus::Hit {
+                hit: make_hit("Y", "http://c"),
+                source_name: "源 C".to_string(),
+                co_sources: Vec::new(),
+            },
+        ];
+        let folded = fold_rows(rows);
+        assert_eq!(folded.len(), 3);
+
+        match &folded[0] {
+            HitOrStatus::Hit {
+                hit, co_sources, ..
+            } => {
+                assert_eq!(hit.name, "X");
+                assert_eq!(co_sources.len(), 1);
+            }
+            HitOrStatus::StatusLine(_) => panic!("row 0 應為折疊後的 X"),
+        }
+        match &folded[1] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "源 M：錯誤 逾時"),
+            HitOrStatus::Hit { .. } => panic!("row 1 應為 StatusLine、文字不變"),
+        }
+        match &folded[2] {
+            HitOrStatus::Hit { hit, .. } => assert_eq!(hit.name, "Y"),
+            HitOrStatus::StatusLine(_) => panic!("row 2 應為 Y"),
+        }
+    }
 }
