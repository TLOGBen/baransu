+/// Pure post-pass: fold duplicate cross-source hits into one row.
+///
+/// Key = `(name.trim(), author-or-empty.trim())`. Iterates in order; the
+/// FIRST occurrence of a key keeps its list position and becomes the
+/// surviving row — later duplicates are removed from the output and their
+/// `(hit, source_name)` is appended to the first occurrence's `co_sources`.
+/// `StatusLine` rows pass through untouched, so their position relative to
+/// surviving rows is preserved (C5 falls out of only ever deleting Hit rows).
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    // Maps fold-key -> index into `out` of the surviving Hit row.
+    let mut seen: Vec<((String, String), usize)> = Vec::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit {
+                hit,
+                source_name,
+                co_sources,
+            } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                if let Some((_, idx)) = seen.iter().find(|(k, _)| *k == key) {
+                    if let HitOrStatus::Hit {
+                        co_sources: existing,
+                        ..
+                    } = &mut out[*idx]
+                    {
+                        existing.push((hit, source_name));
+                        existing.extend(co_sources);
+                    }
+                } else {
+                    seen.push((key, out.len()));
+                    out.push(HitOrStatus::Hit {
+                        hit,
+                        source_name,
+                        co_sources,
+                    });
+                }
+            }
+            HitOrStatus::StatusLine(_) => out.push(row),
+        }
+    }
+    out
+}
