+/// list of source names starting with the primary `source_name`, e.g.
+/// `超維術士 / 牧狐 [3源: 源 A, 源 B, 源 C]`.
+fn hit_row_label(hit: &SearchHit, source_name: &str, co_sources: &[(SearchHit, String)]) -> String {
+    let author = hit.author.as_deref().unwrap_or("-");
+    if co_sources.is_empty() {
+        return format!("{} / {} [{}]", hit.name, author, source_name);
+    }
+    let count = 1 + co_sources.len();
+    let mut names = vec![source_name.to_string()];
+    names.extend(co_sources.iter().map(|(_, n)| n.clone()));
+    format!(
+        "{} / {} [{}源: {}]",
+        hit.name,
+        author,
+        count,
+        names.join(", ")
+    )
 }
 
