+/// Pure post-pass：把 `assemble_rows` 輸出中同鍵（name.trim(),
+/// author-or-empty.trim()）的多個 `Hit` 摺疊為一個 `Folded`，停在首次出現
+/// 位置；`StatusLine` 與單源 `Hit` 原樣保留（REQ-005）。
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    use std::collections::HashMap;
+
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    // 摺疊鍵 → out 中首次出現的輸出位（out 只 push 不刪，index 穩定）。
+    let mut first_pos: HashMap<(String, String), usize> = HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                match first_pos.get(&key) {
+                    Some(&idx) => {
+                        // 同鍵再現：首位元素升級 Folded（或已 Folded 則 push）。
+                        let placeholder = HitOrStatus::StatusLine(String::new());
+                        let folded = match std::mem::replace(&mut out[idx], placeholder) {
+                            HitOrStatus::Hit { hit: h0, source_name: s0 } => HitOrStatus::Folded {
+                                hits: vec![(h0, s0), (hit, source_name)],
+                            },
+                            HitOrStatus::Folded { mut hits } => {
+                                hits.push((hit, source_name));
+                                HitOrStatus::Folded { hits }
+                            }
+                            // first_pos 只登記 Hit/Folded 位，此 arm 不可達。
+                            other => other,
+                        };
+                        out[idx] = folded;
+                    }
+                    None => {
+                        first_pos.insert(key, out.len());
+                        out.push(HitOrStatus::Hit { hit, source_name });
+                    }
+                }
+            }
+            status => out.push(status),
+        }
+    }
+    out
+}
