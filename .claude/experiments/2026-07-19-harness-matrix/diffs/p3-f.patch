+/// Best-effort progress migration (REQ-003, this spec): find the NEW TOC entry
+/// matching the OLD current chapter name. Precedence (higher rule wins even if
+/// a lower rule matches at a smaller idx):
+///   a. exact name equality;
+///   b. equality after stripping ALL Unicode whitespace from both names
+///      (skipped when the stripped old name is empty);
+///   c. chapter-number token equality via
+///      `第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]`
+///      (first capture group), full-width digits normalized to half-width,
+///      compared as strings — 第十二章 vs 第12章 do NOT cross-match.
+/// Within a rule the first hit in ascending-idx order wins (`new_toc` comes
+/// from `list_chapters`, already `ORDER BY idx`). No rule hits → `None`.
+pub fn find_migration_target(old_name: &str, new_toc: &[ChapterMeta]) -> Option<(i64, String)> {
+    // rule a: exact equality.
+    if let Some(c) = new_toc.iter().find(|c| c.name == old_name) {
+        return Some((c.index, c.name.clone()));
+    }
+
+    // rule b: equality after stripping ALL Unicode whitespace (U+3000 included).
+    let strip_ws = |s: &str| s.chars().filter(|ch| !ch.is_whitespace()).collect::<String>();
+    let old_stripped = strip_ws(old_name);
+    if !old_stripped.is_empty() {
+        if let Some(c) = new_toc.iter().find(|c| strip_ws(&c.name) == old_stripped) {
+            return Some((c.index, c.name.clone()));
+        }
+    }
+
+    // rule c: chapter-number token equality (string compare after full-width
+    // digit normalization; Chinese numerals never cross-match Arabic ones).
+    // Compiled per call — switch-source is a one-shot user action.
+    let re = regex::Regex::new(r"第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]")
+        .expect("chapter-number regex is a literal and must compile");
+    let token = |s: &str| -> Option<String> {
+        re.captures(s).map(|cap| {
+            cap[1]
+                .chars()
+                .map(|ch| match ch {
+                    '０'..='９' => {
+                        char::from_u32(ch as u32 - '０' as u32 + '0' as u32).expect("digit range")
+                    }
+                    _ => ch,
+                })
+                .collect()
+        })
+    };
+    let old_token = token(old_name)?;
+    if let Some((idx, name)) = new_toc
+        .iter()
+        .find(|c| token(&c.name).as_deref() == Some(old_token.as_str()))
+        .map(|c| (c.index, c.name.clone()))
+    {
+        return Some((idx, name));
+    }
+    None
+}
+
+/// How the reading progress was resolved by a successful switch (REQ-004).
+/// Presentation-internal type — deliberately NOT part of the Library PL.
+#[derive(Debug, PartialEq)]
+pub enum ProgressResolution {
+    /// Best-effort migration hit: progress now points at `idx` of the NEW toc.
+    Migrated { idx: i64, name: String },
+    /// No match (or no old progress / unresolvable name) — reset to first idx.
+    Reset,
+}
+
 /// Outcome of a successful source-switch — surfaces what the caller needs to
-/// rebuild its UI (`new_progress_idx`, `chapter_count`, `new_first_chapter_name`).
+/// rebuild its UI (`new_progress_idx`, `chapter_count`, `new_first_chapter_name`,
+/// and the migrated-vs-reset `progress` resolution).
 #[derive(Debug)]
 pub struct SwitchOutcome {
+    /// Kept per spec (既有三欄不動) and pinned by tests; since REQ-004 unified
+    /// both UI paths onto `describe_progress`, the bin no longer reads it.
+    #[allow(dead_code)]
     pub new_progress_idx: i64,
     pub chapter_count: usize,
     pub new_first_chapter_name: String,
+    pub progress: ProgressResolution,
+}
+
+/// REQ-004: one-line zh-TW description of the progress resolution, shared by
+/// the CLI println and the TUI toast so both paths stay word-for-word aligned.
+/// Never derives 「第N章」 from idx+1 — idx values are NOT dense (czbooks
+/// first row idx hole is empirically verified); only real chapter names appear.
+pub fn describe_progress(outcome: &SwitchOutcome) -> String {
+    match &outcome.progress {
+        ProgressResolution::Migrated { idx, name } => {
+            format!("進度已遷移：{}（idx {}）", name, idx)
+        }
+        ProgressResolution::Reset => {
+            format!("進度重置：{}", outcome.new_first_chapter_name)
+        }
+    }
 }
 
