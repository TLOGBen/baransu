+        HitOrStatus::Hit {
+            hit: make_hit_author(name, author, src_url),
+            source_name: source_name.into(),
+        }
+    }
+
+    /// C15: 三源同書（超維術士/牧狐 × A,B,C）→ 一列 Folded、hits.len == 3、
+    /// 來源名依出現順序。
+    #[test]
+    fn req005_c15_three_sources_same_book_fold_to_one_row() {
+        let rows = fold_rows(vec![
+            hit_row("超維術士", Some("牧狐"), "http://a", "源 A"),
+            hit_row("超維術士", Some("牧狐"), "http://b", "源 B"),
+            hit_row("超維術士", Some("牧狐"), "http://c", "源 C"),
+        ]);
+        assert_eq!(rows.len(), 1, "三源同書應摺疊為一列");
+        match &rows[0] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits.len(), 3, "hits 應含全部三源命中");
+                let sources: Vec<&str> = hits.iter().map(|(_, s)| s.as_str()).collect();
+                assert_eq!(sources, vec!["源 A", "源 B", "源 C"], "來源名依出現順序");
+            }
+            _ => panic!("row 0 應為 Folded"),
+        }
+    }
+
+    /// C16: 同名不同作者不摺疊；同作者不同名也不摺疊。
+    #[test]
+    fn req005_c16_different_author_or_name_stays_separate() {
+        let rows = fold_rows(vec![
+            hit_row("超維術士", Some("牧狐"), "http://a", "源 A"),
+            hit_row("超維術士", Some("別人"), "http://b", "源 B"),
+            hit_row("另一本", Some("牧狐"), "http://c", "源 C"),
+        ]);
+        assert_eq!(rows.len(), 3, "鍵不同（作者或書名）皆不得摺疊");
+        for (i, row) in rows.iter().enumerate() {
+            assert!(matches!(row, HitOrStatus::Hit { .. }), "row {} 應維持 Hit variant", i);
+        }
+    }
+
+    /// C16 邊界: author None / Some("") / Some("  ") 視為同作者鍵；
+    /// name 兩側空白 trim 後同鍵。
+    #[test]
+    fn req005_c16_author_none_empty_blank_share_key() {
+        let rows = fold_rows(vec![
+            hit_row("超維術士", None, "http://a", "源 A"),
+            hit_row("超維術士", Some(""), "http://b", "源 B"),
+            hit_row(" 超維術士 ", Some("  "), "http://c", "源 C"),
+        ]);
+        assert_eq!(rows.len(), 1, "None / \"\" / \"  \" 作者與 trim 後同名應同鍵");
+        match &rows[0] {
+            HitOrStatus::Folded { hits } => assert_eq!(hits.len(), 3),
+            _ => panic!("row 0 應為 Folded"),
+        }
+    }
+
+    /// C17: [Hit X(A), Hit Y(B), Hit X(C)] → [Folded X{A,C}, Hit Y(B)] ——
+    /// 摺疊列停在首次出現位置、單源命中維持 Hit variant。
+    #[test]
+    fn req005_c17_fold_lands_at_first_occurrence_single_source_stays_hit() {
+        let rows = fold_rows(vec![
+            hit_row("X", Some("甲"), "http://a", "源 A"),
+            hit_row("Y", Some("乙"), "http://b", "源 B"),
+            hit_row("X", Some("甲"), "http://c", "源 C"),
+        ]);
+        assert_eq!(rows.len(), 2);
+        match &rows[0] {
+            HitOrStatus::Folded { hits } => {
+                let sources: Vec<&str> = hits.iter().map(|(_, s)| s.as_str()).collect();
+                assert_eq!(sources, vec!["源 A", "源 C"], "X 摺疊於首次出現位置、含 A,C");
+            }
+            _ => panic!("row 0 應為 Folded（X 首次出現位置）"),
+        }
+        match &rows[1] {
+            HitOrStatus::Hit { hit, source_name } => {
+                assert_eq!(hit.name, "Y");
+                assert_eq!(source_name, "源 B", "單源命中維持 Hit variant");
+            }
+            _ => panic!("row 1 應為 Hit（Y 單源）"),
+        }
+    }
+
+    /// C19: StatusLine 相對存活列位置不變 ——
+    /// [Hit X(A), Status(源 B：逾時), Hit X(C), Status(源 D 未查)]
+    /// → [Folded X{A,C}, Status, Status]。
+    #[test]
+    fn req005_c19_statusline_relative_position_preserved() {
+        let rows = fold_rows(vec![
+            hit_row("X", Some("甲"), "http://a", "源 A"),
+            HitOrStatus::StatusLine("源 B：逾時".into()),
+            hit_row("X", Some("甲"), "http://c", "源 C"),
+            HitOrStatus::StatusLine("源 D 未查（時間預算用盡）".into()),
+        ]);
+        assert_eq!(rows.len(), 3);
+        assert!(matches!(&rows[0], HitOrStatus::Folded { hits } if hits.len() == 2));
+        match &rows[1] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "源 B：逾時"),
+            _ => panic!("row 1 應為 StatusLine（源 B）"),
+        }
+        match &rows[2] {
+            HitOrStatus::StatusLine(s) => assert_eq!(s, "源 D 未查（時間預算用盡）"),
+            _ => panic!("row 2 應為 StatusLine（源 D）"),
+        }
+    }
+
+    /// 邊界: fold_rows(vec![]) → vec![]。
+    #[test]
+    fn req005_fold_rows_empty_input() {
+        assert!(fold_rows(vec![]).is_empty());
+    }
+
+    // ------------------------------------------------------------------
+    // REQ-005/REQ-006 Folded 列渲染與互動（C15 顯示半邊、C18、first_hit_idx）
+    // ------------------------------------------------------------------
+
+    /// C15 顯示半邊: 標籤含書名、作者、來源數與全部來源名（依出現順序）。
+    #[test]
+    fn req006_folded_label_shows_name_author_count_and_all_sources() {
+        let hits = vec![
+            (make_hit_author("超維術士", Some("牧狐"), "http://a"), "A".to_string()),
+            (make_hit_author("超維術士", Some("牧狐"), "http://b"), "B".to_string()),
+            (make_hit_author("超維術士", Some("牧狐"), "http://c"), "C".to_string()),
+        ];
+        let label = folded_label(&hits);
+        assert_eq!(label, "超維術士 / 牧狐 [3源: A, B, C]");
+        assert!(label.contains("3源"), "應含來源數: {}", label);
+        assert!(label.contains("A, B, C"), "應含全部來源名依序: {}", label);
+    }
+
+    /// C15 顯示半邊邊界: 無作者顯示 `-`。
+    #[test]
+    fn req006_folded_label_no_author_shows_dash() {
+        let hits = vec![
+            (make_hit_author("X", None, "http://a"), "A".to_string()),
+            (make_hit_author("X", None, "http://b"), "B".to_string()),
+        ];
+        assert_eq!(folded_label(&hits), "X / - [2源: A, B]");
+    }
+
+    /// C18: Enter on Folded → 以 hits[0] 之 hit 走既有入架流程。空 db 下
+    /// get_novel_by_book_url → None、get_source(hit.source_url) → None，
+    /// 可觀察結果 = Stay + 狀態列「找不到書源：<第一來源 source_url>」。
+    #[tokio::test]
+    async fn req006_c18_enter_on_folded_acts_on_first_source_hit() {
+        let mut s = SearchScreen::new();
+        let mut ctx = test_ctx();
+        let mut list_state = ListState::default();
+        list_state.select(Some(0));
+        s.state = SearchState::Results {
+            rows: vec![HitOrStatus::Folded {
+                hits: vec![
+                    (make_hit_author("X", Some("甲"), "http://a"), "源 A".to_string()),
+                    (make_hit_author("X", Some("甲"), "http://c"), "源 C".to_string()),
+                ],
+            }],
+            list_state,
+        };
+        let t = s.handle_event(press(KeyCode::Enter), &mut ctx).await;
+        assert!(matches!(t, Transition::Stay), "空 db 找不到書源應 Stay");
+        let SearchState::Results { rows, .. } = &s.state else {
+            panic!("應仍在 Results state");
+        };
+        let statuses: Vec<&str> = rows
+            .iter()
+            .filter_map(|r| match r {
+                HitOrStatus::StatusLine(s) => Some(s.as_str()),
+                _ => None,
+            })
+            .collect();
+        assert!(
+            statuses.iter().any(|s| s.contains("http://a")),
+            "Enter 應取 hits[0]（源 A 的 hit，source_url=http://a）流入既有分支；狀態列: {:?}",
+            statuses
+        );
+        assert!(
+            !statuses.iter().any(|s| s.contains("http://c")),
+            "不得作用於第二來源 (http://c): {:?}",
+            statuses
+        );
+    }
+
+    /// REQ-006: first_hit_idx 把 Folded 視為命中列（首個可作用列在 Folded 時選中它）。
+    #[test]
+    fn req006_first_hit_idx_treats_folded_as_hit_row() {
+        let rows = vec![
+            HitOrStatus::StatusLine("源 B：逾時".into()),
+            HitOrStatus::Folded {
+                hits: vec![
+                    (make_hit_author("X", Some("甲"), "http://a"), "源 A".to_string()),
+                    (make_hit_author("X", Some("甲"), "http://c"), "源 C".to_string()),
+                ],
+            },
+            hit_row("Y", Some("乙"), "http://b", "源 B"),
+        ];
+        assert_eq!(first_hit_idx(&rows), 1, "首個可作用列為 index 1 的 Folded");
+        // rows 首列即 Folded 時選中它。
+        let rows2 = vec![
+            HitOrStatus::Folded {
+                hits: vec![
+                    (make_hit_author("X", Some("甲"), "http://a"), "源 A".to_string()),
+                    (make_hit_author("X", Some("甲"), "http://c"), "源 C".to_string()),
+                ],
+            },
+            HitOrStatus::StatusLine("源 D 未查（時間預算用盡）".into()),
+        ];
+        assert_eq!(first_hit_idx(&rows2), 0, "首列 Folded 應被選中");
+    }
+
+    /// 邊界: 同一來源重複命中同書 → 照併、計數含重複（決策見 .exp/decision-log.md）。
+    #[test]
+    fn req005_same_source_duplicate_hits_fold_and_count_includes_dup() {
+        let rows = fold_rows(vec![
+            hit_row("X", Some("甲"), "http://a", "源 A"),
+            hit_row("X", Some("甲"), "http://a", "源 A"),
+        ]);
+        assert_eq!(rows.len(), 1);
+        match &rows[0] {
+            HitOrStatus::Folded { hits } => {
+                assert_eq!(hits.len(), 2, "計數含同源重複");
+                let sources: Vec<&str> = hits.iter().map(|(_, s)| s.as_str()).collect();
+                assert_eq!(sources, vec!["源 A", "源 A"]);
+            }
+            _ => panic!("row 0 應為 Folded"),
+        }
+    }
 }
