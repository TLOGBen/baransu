+/// (REQ-008, .claude/analyze/2026-07-19-legado-parity) Pure post-pass: fold
+/// `HitOrStatus::Hit` rows whose `(name.trim(), author-or-empty.trim())` are
+/// equal into one row. First occurrence keeps its list position AND becomes
+/// the primary `hit` (so the unmodified Enter path automatically acts on the
+/// first source — REQ-009/C18); later occurrences' `source_name` (and
+/// defensively their own `extra_sources`) are appended to the first's
+/// `extra_sources`, in encounter order, without dedup. `StatusLine` rows pass
+/// through untouched, at their original relative position. `assemble_rows`'s
+/// own output contract (one row per hit, unfolded) is untouched — this is a
+/// separate pass applied only in `do_search`.
+pub fn fold_rows(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    let mut key_to_out_idx: std::collections::HashMap<(String, String), usize> =
