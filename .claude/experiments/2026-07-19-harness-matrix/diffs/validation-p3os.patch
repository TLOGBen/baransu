+/// Pure helper (REQ-005 / TASK-c-01)：折疊同書跨源命中。`FOLD_KEY` =
+/// `(name.trim(), author-or-empty.trim())`；相等的 `Hit` 列合併成一列，
+/// order-preserving（群組落在其首成員原索引位置），`StatusLine` 原位保留。
+///
+/// - 鍵相同 ≥2 筆 `Hit` → 一個 `FoldedHit { primary: 首個遇到, source_names }`。
+/// - 鍵只出現一次 → 維持 `Hit`（不轉型別），位置不變。
+/// - `StatusLine` 一律原樣、原位推入輸出，不參與折疊分組。
+pub fn fold_duplicate_hits(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    // 單趟掃描收集：鍵 -> 群組（source_name, hit）序列；同時記首次出現的
+    // 「輸出槽位」，讓群組（或單源列）能落在其首成員原索引位置。
+    let mut groups: Vec<(String, String, Vec<(String, SearchHit)>)> = Vec::new(); // (name_trim, author_trim, members)
+    // slot 序列：Group(idx) 代表該位置屬於某折疊群組（僅群組首次出現時記錄），
+    // Status(s) 代表該位置是既有 StatusLine 或已折疊列（原樣直通），直接原樣輸出。
+    enum Slot {
+        Group(usize),
+        Status(HitOrStatus),
+    }
+    let mut slots: Vec<Slot> = Vec::with_capacity(rows.len());
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let name_key = hit.name.trim().to_string();
+                let author_key = hit.author.as_deref().unwrap_or("").trim().to_string();
+                if let Some(gi) = groups
+                    .iter()
+                    .position(|(n, a, _)| *n == name_key && *a == author_key)
+                {
+                    groups[gi].2.push((source_name, hit));
+                    // 非首次出現，不新增 slot（群組已佔用首次位置的 slot）。
+                } else {
+                    let gi = groups.len();
+                    groups.push((name_key, author_key, vec![(source_name, hit)]));
+                    slots.push(Slot::Group(gi));
+                }
+            }
+            // `fold_duplicate_hits` 的常規輸入是 `assemble_rows` 的輸出（只含
+            // Hit/StatusLine），但保留此臂讓函式對已折疊輸入冪等、原位直通。
+            already @ HitOrStatus::FoldedHit { .. } => {
+                slots.push(Slot::Status(already));
+            }
+            HitOrStatus::StatusLine(s) => {
+                slots.push(Slot::Status(HitOrStatus::StatusLine(s)));
+            }
+        }
+    }
+
+    let mut out = Vec::with_capacity(slots.len());
+    for slot in slots {
+        match slot {
+            Slot::Status(row) => out.push(row),
+            Slot::Group(gi) => {
+                let (_, _, mut members) = std::mem::replace(
+                    &mut groups[gi],
+                    (String::new(), String::new(), Vec::new()),
+                );
+                if members.len() == 1 {
+                    let (source_name, hit) = members.remove(0);
+                    out.push(HitOrStatus::Hit { hit, source_name });
+                } else {
+                    let mut source_names = Vec::with_capacity(members.len());
+                    let mut iter = members.into_iter();
+                    let (first_source, primary) = iter.next().expect("group has >=1 member");
+                    source_names.push(first_source);
+                    for (source_name, _hit) in iter {
+                        source_names.push(source_name);
+                    }
+                    out.push(HitOrStatus::FoldedHit {
+                        primary,
+                        source_names,
+                    });
+                }
+            }
+        }
+    }
+    out
