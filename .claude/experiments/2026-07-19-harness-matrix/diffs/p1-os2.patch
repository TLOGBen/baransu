+/// Pure post-pass：把 `assemble_rows` 產出的攤平行序列，依 `(name.trim(),
+/// author.trim() 或空字串)` fold-key 摺疊同一本書跨多源的命中為一行
+/// `FoldedHit`。`StatusLine` 行完全不受影響、位置維持原樣（C5）；摺疊後的
+/// 行沿用其「第一次出現」時的 list 位置（C3）；單一來源的書維持原本
+/// `Hit` 顯示（C3）。此 fn 不碰 IO / db / scraper，由 unit test 驗證
+/// C1/C2/C3/C5。
+pub fn fold_hits(rows: Vec<HitOrStatus>) -> Vec<HitOrStatus> {
+    use std::collections::HashMap;
+
+    let mut out: Vec<HitOrStatus> = Vec::with_capacity(rows.len());
+    // fold-key -> index into `out`
+    let mut key_to_idx: HashMap<(String, String), usize> = HashMap::new();
+
+    for row in rows {
+        match row {
+            HitOrStatus::Hit { hit, source_name } => {
+                let key = (
+                    hit.name.trim().to_string(),
+                    hit.author.as_deref().unwrap_or("").trim().to_string(),
+                );
+                if let Some(&idx) = key_to_idx.get(&key) {
+                    // Already seen this book — upgrade (or extend) the existing
+                    // entry at its first-occurrence position.
+                    match &mut out[idx] {
+                        HitOrStatus::Hit {
+                            hit: first_hit,
+                            source_name: first_source,
+                        } => {
+                            let folded = HitOrStatus::FoldedHit {
+                                hit: first_hit.clone(),
+                                sources: vec![first_source.clone(), source_name],
+                            };
+                            out[idx] = folded;
+                        }
+                        HitOrStatus::FoldedHit { sources, .. } => {
+                            sources.push(source_name);
+                        }
+                        HitOrStatus::StatusLine(_) => {
+                            // Should never happen: key only maps to Hit/FoldedHit
+                            // entries, never StatusLine.
+                            unreachable!("fold-key mapped to a StatusLine row");
+                        }
+                    }
+                } else {
+                    key_to_idx.insert(key, out.len());
+                    out.push(HitOrStatus::Hit { hit, source_name });
+                }
+            }
+            HitOrStatus::FoldedHit { .. } => {
+                // assemble_rows never produces FoldedHit; kept for exhaustiveness
+                // if this fn is ever re-applied to already-folded output.
+                out.push(row);
+            }
+            HitOrStatus::StatusLine(_) => {
+                out.push(row);
+            }
+        }
+    }
+    out
+}
