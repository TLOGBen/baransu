+/// Strip ALL Unicode whitespace (incl. U+3000 full-width space) from `s`.
+/// Used by migration rule (b) — whitespace-insensitive name equality.
+fn strip_unicode_whitespace(s: &str) -> String {
+    s.chars().filter(|c| !c.is_whitespace()).collect()
+}
+
+/// Extract the chapter-number token from a chapter name via
+/// `第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]`,
+/// normalizing full-width digits (U+FF10..FF19) to half-width ASCII digits.
+/// Returns `None` if the pattern doesn't match.
+fn extract_chapter_number_token(name: &str) -> Option<String> {
+    // Compiled once per call — migration is a rare, non-hot-path operation
+    // (once per switch-source invocation), so no lazy_static/once_cell needed.
+    let re = Regex::new(r"第\s*([0-9０-９一二三四五六七八九十百千零〇两兩]+)\s*[章回節节卷]")
+        .expect("static regex is valid");
+    let caps = re.captures(name)?;
+    let token = caps.get(1)?.as_str();
+    let normalized: String = token
+        .chars()
+        .map(|c| {
+            let cp = c as u32;
+            if (0xFF10..=0xFF19).contains(&cp) {
+                // full-width '０'..'９' → half-width '0'..'9'
+                char::from_u32(cp - 0xFF10 + '0' as u32).unwrap_or(c)
+            } else {
+                c
+            }
+        })
+        .collect();
+    Some(normalized)
+}
+
+/// Best-effort migration of the old current chapter into the new TOC by
+/// name matching (REQ item B). Precedence DOMINATES position: rule (a) is
+/// checked across the WHOLE new TOC (ascending idx) before rule (b) is
+/// checked across the whole TOC, before rule (c) — an exact match later in
+/// the TOC beats a whitespace-variant match earlier in the TOC.
+///
+/// Returns the matched NEW `ChapterMeta.index` VALUE (not its vec position),
+/// or `None` if no rule finds a candidate.
+pub fn migrate_chapter_index(old_name: &str, new_toc: &[ChapterMeta]) -> Option<i64> {
+    // Rule (a): exact name equality.
+    if let Some(c) = new_toc.iter().find(|c| c.name == old_name) {
+        return Some(c.index);
+    }
+
+    // Rule (b): equality after stripping all Unicode whitespace.
+    let old_stripped = strip_unicode_whitespace(old_name);
+    if let Some(c) = new_toc
+        .iter()
+        .find(|c| strip_unicode_whitespace(&c.name) == old_stripped)
+    {
+        return Some(c.index);
+    }
+
+    // Rule (c): chapter-number token equality.
+    let old_token = extract_chapter_number_token(old_name)?;
+    new_toc.iter().find_map(|c| {
+        let new_token = extract_chapter_number_token(&c.name)?;
+        if new_token == old_token {
+            Some(c.index)
+        } else {
+            None
+        }
+    })
 }
 
