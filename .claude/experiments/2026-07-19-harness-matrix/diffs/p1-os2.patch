+#[derive(Debug, PartialEq, Eq)]
+pub enum ProgressMigration {
+    /// Best-effort name match found the old chapter in the new TOC.
+    Migrated { idx: i64, chapter_name: String },
+    /// No match (no progress row / unresolvable old name / no candidate in
+    /// new TOC) — fell back to the new TOC's first chapter.
